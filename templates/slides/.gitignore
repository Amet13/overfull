# Build outputs in the project root (CI uploads them as artifacts). PDFs in
# figures/ and other folders are sources: they stay tracked.
/*.pdf

# Reviews are confidential: keep them on your machine (respond-to-reviewers)
notes/reviews.md

# Overfull working files (diff builds, rendered pages); latexdiff output
.overfull/
*-diff[0-9a-f]*.tex

# Editors / OS
.DS_Store
*.swp
*~

# Failed biber runs, luamml output
*-SAVE-ERROR
